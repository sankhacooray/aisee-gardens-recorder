{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve recorder (4766)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "4766"],
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "https?://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
